{
  "name": "assessment/carelink-follow-up", "type": "project", "description": "CareLink Follow-Up assessment demo", "license": "MIT",
  "require": {"php": "^8.2", "laravel/framework": "^12.0", "laravel/tinker": "^2.10"},
  "require-dev": {"phpunit/phpunit": "^11.5", "laravel/pint": "^1.20"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/","Database\\Factories\\": "database/factories/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"], "test": "@php artisan test"},
  "config": {"sort-packages": true}, "minimum-stability": "stable", "prefer-stable": true
}
